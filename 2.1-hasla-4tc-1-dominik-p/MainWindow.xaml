<Window x:Class="Haslogen.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Haslogen"
        Height="420"
        Width="520"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
    </Window.Resources>
    <Border Padding="20">
        <StackPanel>
            <TextBlock Text="Generator haseł" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <TextBlock FontSize="14">
                <Run Text="Długość hasła:"/>
                <Run x:Name="LengthValueText" FontWeight="SemiBold" Text="16"/>
            </TextBlock>
            <Slider x:Name="LengthSlider"
                    Minimum="4"
                    Maximum="64"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    Value="16"
                    Margin="0,8,0,4"
                    ValueChanged="LengthSlider_ValueChanged"/>
            <TextBlock Text="4 – 64 znaki" Foreground="#666666" FontSize="12" Margin="0,0,0,12"/>

            <TextBlock Text="Zestawy znaków" FontSize="14" FontWeight="SemiBold"/>
            <CheckBox x:Name="UppercaseCheck" Content="Wielkie litery (A–Z)" IsChecked="True" Checked="Charset_Changed" Unchecked="Charset_Changed"/>
            <CheckBox x:Name="LowercaseCheck" Content="Małe litery (a–z)" IsChecked="True" Checked="Charset_Changed" Unchecked="Charset_Changed"/>
            <CheckBox x:Name="DigitsCheck" Content="Cyfry (0–9)" IsChecked="True" Checked="Charset_Changed" Unchecked="Charset_Changed"/>
            <CheckBox x:Name="SpecialCheck" Content="Znaki specjalne (!@#$…)" IsChecked="True" Checked="Charset_Changed" Unchecked="Charset_Changed"/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                <Button x:Name="GenerateButton" Content="Generuj" Click="GenerateButton_Click" Margin="0,0,10,0"/>
                <Button x:Name="CopyButton" Content="Kopiuj" Click="CopyButton_Click" IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="Wygenerowane hasło" FontSize="13" Margin="0,0,0,4"/>
            <TextBox x:Name="PasswordBox"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     FontSize="16"
                     Padding="8,6"
                     TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Siła:" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock x:Name="StrengthText"
                           Text="—"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="#666666" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
